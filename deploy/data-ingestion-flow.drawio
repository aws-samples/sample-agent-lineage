        <!-- ============ Legend ============ -->
        <mxCell id="legend" value="Solid = sync pipeline (on demand) · Dashed green = AWS API reads · Dashed gold = event-push path (seed today, streaming later).&#10;Everything is idempotent: nodes merge facets, edges accumulate counts, re-syncing never duplicates. Failures are per-connector and reported in the sync result." style="text;html=1;fontSize=11;fontColor=#5A6C86;align=left;whiteSpace=wrap;" vertex="1" parent="1">
