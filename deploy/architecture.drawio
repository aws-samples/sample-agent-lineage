        <!-- ================= Legend note ================= -->
        <mxCell id="note" value="Solid = request/data path · Dashed = auth / control path.&#10;ALB answers 403 to anything without the CloudFront origin header; every /api/* call additionally requires a Cognito JWT.&#10;Sync is manual (Connect AWS button) — connectors read AgentCore, Guardrails and CloudWatch with the read-only task role." style="text;html=1;fontSize=11;fontColor=#5A6C86;align=left;whiteSpace=wrap;" vertex="1" parent="1">
